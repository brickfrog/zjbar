{
  "description": "Forward Gemini CLI hook events to zjbar Zellij plugin via zellij pipe",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -f \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" && exec \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" || exit 0'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "SessionStart"
            }
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -f \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" && exec \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" || exit 0'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "BeforeAgent"
            }
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -f \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" && exec \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" || exit 0'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "BeforeTool"
            }
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -f \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" && exec \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" || exit 0'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "AfterTool"
            }
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -f \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" && exec \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" || exit 0'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "AfterAgent"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'test -f \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" && exec \"${extensionPath}/scripts/zjbar-gemini-hook.sh\" || exit 0'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "SessionEnd"
            }
          }
        ]
      }
    ]
  }
}
