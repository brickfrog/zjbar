{
  "description": "Forward Gemini CLI hook events to zjbar Zellij plugin via zellij pipe",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '${extensionPath}/scripts/zjbar-gemini-hook.sh'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "SessionStart"
            }
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '${extensionPath}/scripts/zjbar-gemini-hook.sh'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "BeforeAgent"
            }
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '${extensionPath}/scripts/zjbar-gemini-hook.sh'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "BeforeTool"
            }
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '${extensionPath}/scripts/zjbar-gemini-hook.sh'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "AfterTool"
            }
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '${extensionPath}/scripts/zjbar-gemini-hook.sh'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "AfterAgent"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '${extensionPath}/scripts/zjbar-gemini-hook.sh'",
            "timeout": 5000,
            "env": {
              "ZJBAR_GEMINI_EVENT": "SessionEnd"
            }
          }
        ]
      }
    ]
  }
}
